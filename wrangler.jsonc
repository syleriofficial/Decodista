{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "decodista",
  "account_id": "45659c4970d9d11deb060027edd34103",
  "main": "vinext/server/fetch-handler",
  "compatibility_date": "2026-09-16",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "routes": [
    {
      "pattern": "decodista.com",
      "custom_domain": true
    }
  ],
  "vars": {
    "NEXT_PUBLIC_SITE_URL": "https://decodista.com",
    "NEXT_PUBLIC_GA_MEASUREMENT_ID": "G-1T57TWPXM6",
    "NEXT_PUBLIC_TURNSTILE_SITE_KEY": "0x4AAAAAAFKUUdBVj5U5Ujq3"
  },
  "send_email": [
    {
      "name": "EMAIL"
    }
  ],
  "ratelimits": [
    {
      "name": "CONTACT_RATE_LIMITER",
      "namespace_id": "26093001",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ],
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  }
}
