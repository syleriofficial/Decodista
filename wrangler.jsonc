{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "decodista",
  "account_id": "45659c4970d9d11deb060027edd34103",
  "main": "vinext/server/fetch-handler",
  "compatibility_date": "2026-09-16",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "routes": [
    {
      "pattern": "decodista.com",
      "custom_domain": true
    }
  ],
  "vars": {
    "NEXT_PUBLIC_SITE_URL": "https://decodista.com"
  },
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  }
}
