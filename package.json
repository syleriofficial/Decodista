{
  "name": "decodista",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "node scripts/install-ci.mjs",
    "dev": "node scripts/run-framework.mjs dev",
    "build": "node scripts/run-framework.mjs build",
    "deploy": "vinext-cloudflare deploy",
    "deploy:ci": "vinext-cloudflare deploy --skip-build",
    "start": "node --import ./scripts/sites-env.mjs ./node_modules/wrangler/bin/wrangler.js dev --config dist/server/wrangler.json --compatibility-date 2026-05-22 --local --persist-to .wrangler/state --ip 127.0.0.1 --inspector-port 0",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "typecheck": "tsc --noEmit",
    "content:validate": "node scripts/validate-content.mjs",
    "cms:test": "node scripts/test-cms-content.mjs",
    "contact:test": "node --test scripts/test-contact.mjs",
    "contact:leak-check": "node scripts/check-contact-leaks.mjs",
    "site:contracts": "node scripts/validate-site-contracts.mjs",
    "rss:test": "node --test scripts/test-rss.mjs",
    "security:audit": "npm audit --omit=dev --audit-level=high",
    "security:audit:all": "npm audit",
    "release:check": "npm run security:audit && npm run content:validate && npm run cms:test && npm run contact:test && npm run site:contracts && npm run search:test && npm run rss:test && npm run lint && npm run typecheck && npm run build && npm run images:test && npm run contact:leak-check",
    "images:test": "node scripts/test-responsive-images.mjs",
    "search:test": "node --test scripts/test-search.mjs"
  },
  "dependencies": {
    "lucide-react": "^1.31.0",
    "next": "16.4.3",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.68.0",
    "@cloudflare/workers-types": "5.20261109.1",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vinext/cloudflare": "1.3.3",
    "@vitejs/plugin-react": "6.3.0",
    "@vitejs/plugin-rsc": "0.5.39",
    "eslint": "9.39.4",
    "eslint-config-next": "16.4.6",
    "marked": "18.2.0",
    "react-server-dom-webpack": "19.3.1",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "vinext": "1.4.4",
    "vite": "8.3.7",
    "wrangler": "4.159.0",
    "yaml": "2.9.1"
  },
  "type": "module",
  "overrides": {
    "baseline-browser-mapping": "2.11.25",
    "source-map-js": "1.2.2",
    "miniflare": {
      "sharp": "0.35.5"
    }
  }
}
